  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc -b && vite build",
    "prepare:pages": "node scripts/prepare-pages.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
