    "vite": "8.0.13"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "manifold-3d": "^3.5.4",
    "typescript": "5.9.3"
  }
